# GAC Menu Editor — Environment Configuration
# Copy to .env and adjust values as needed.

# Backend server
# GAC port allocation (avoid conflicts):
#   8000  — GAC-Concierge API
#   8100  — GAC-Menu-editor (this app)
#   8501  — GAC-Concierge Streamlit
#   8503  — GAC-display shell
#   8504  — GAC-display session menu
#   8510  — GAC-cocktails
#   8600  — GAC-display backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8100

# Data & logs
DATA_DIR=./data
LOCATIONS_FILE=./data/locations.json
LOG_DIR=./logs
LOG_LEVEL=INFO

# Auth
# JWT_SECRET_KEY is auto-generated on first run; set here to override.
# JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480
ADMIN_DEFAULT_PASSWORD=changeme123
LOGIN_RATE_LIMIT=5

# Set to 1 to disable rate limiting (useful for development)
# DISABLE_RATE_LIMIT=1
